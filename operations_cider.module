<?php

/**
 * @file
 * Operations CiDeR module hooks.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_node_insert().
 *
 * Send CiDeR resources to all affiliated sites if using the domain_access module.
 */
function operations_cider_node_insert(EntityInterface $entity) {
  $moduleHandler = \Drupal::service('module_handler');
  if ($moduleHandler->moduleExists('domain_access')) {
    $type = $entity->bundle();
    if ($type == 'access_active_resources_from_cid') {
      $entity->field_domain_all_affiliates = TRUE;
      $entity->save();
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for node_access_active_resources_from_cid_edit_form.
 *
 * Makes CiDeR-synced fields readonly so editors can see the data but know to
 * request changes in CiDeR rather than editing here.
 */
function operations_cider_form_node_access_active_resources_from_cid_edit_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $cider_fields = [
    'title',
    'body',
    'field_cider_resource_id',
    'field_access_global_resource_id',
    'field_cider_resource_type',
    'field_cider_short_name',
    'field_cider_project_affiliation',
    'field_cider_latest_status',
    'field_cider_latest_status_begin',
    'field_cider_latest_status_end',
    'field_access_org_name',
    'field_access_org_url',
    'field_access_org_logo_url',
    'field_cider_detail_view_url',
    'field_cider_raw_data_url',
    'field_rp_top_software',
    'field_rp_queue_metrics',
  ];

  foreach ($cider_fields as $field_name) {
    if (isset($form[$field_name])) {
      $form[$field_name]['#disabled'] = TRUE;
      $form[$field_name]['#prefix'] = ($form[$field_name]['#prefix'] ?? '') . '<div class="cider-synced-field">';
      $form[$field_name]['#suffix'] = '</div>' . ($form[$field_name]['#suffix'] ?? '');
    }
  }

  // Add a note above the CiDeR section.
  $form['cider_section_notice'] = [
    '#type' => 'markup',
    '#markup' => '<div class="messages messages--warning"><strong>CiDeR-synced fields</strong> — The fields below are automatically synced from CiDeR. To change this data, update it in CiDeR and it will sync here on the next import.</div>',
    '#weight' => 49,
  ];
}

/**
 * Implements hook_cron().
 *
 * Runs daily at 2 AM to cache dynamic resource data from external APIs.
 */
function operations_cider_cron() {
  $hour = (int) date('H');

  // Run at 2 AM. The state-based interval checks below prevent duplicate runs.
  if ($hour !== 2) {
    return;
  }

  $state = \Drupal::state();

  // Queue metrics from XDMoD — daily.
  $last_metrics = $state->get('operations_cider.queue_metrics_last_run', 0);
  if (\Drupal::time()->getRequestTime() - $last_metrics > 86400) {
    \Drupal::service('operations_cider.queue_metrics')->updateAll();
    $state->set(
      'operations_cider.queue_metrics_last_run',
      \Drupal::time()->getRequestTime()
    );
  }

  // Top software from XDMoD + SDS enrichment — weekly.
  $last_software = $state->get('operations_cider.top_software_last_run', 0);
  if (\Drupal::time()->getRequestTime() - $last_software > 604800) {
    \Drupal::service('operations_cider.top_software')->updateAll();
    $state->set(
      'operations_cider.top_software_last_run',
      \Drupal::time()->getRequestTime()
    );
  }

  // OOD software enrichment — weekly.
  $last_ood = $state->get('operations_cider.ood_software_last_run', 0);
  if (\Drupal::time()->getRequestTime() - $last_ood > 604800) {
    \Drupal::service('operations_cider.ood_software')->updateAll();
    $state->set('operations_cider.ood_software_last_run', \Drupal::time()->getRequestTime());
  }

  // SDS availability check — weekly.
  $last_sds = $state->get('operations_cider.sds_availability_last_run', 0);
  if (\Drupal::time()->getRequestTime() - $last_sds > 604800) {
    \Drupal::service('operations_cider.sds_availability')->updateAll();
    $state->set(
      'operations_cider.sds_availability_last_run',
      \Drupal::time()->getRequestTime()
    );
  }
}

/**
 * Resolves the display name for a CiDeR resource node.
 *
 * Precedence: editor override (field_rp_display_name), then the CiDeR short
 * name (field_cider_short_name), then the CiDeR descriptive title. A blank
 * override falls through, so most nodes resolve to the short name.
 */
function operations_cider_resource_display_name(\Drupal\node\NodeInterface $node): string {
  if ($node->hasField('field_rp_display_name')) {
    $display = trim((string) $node->get('field_rp_display_name')->value);
    if ($display !== '') {
      return $display;
    }
  }
  if ($node->hasField('field_cider_short_name')) {
    $short = trim((string) $node->get('field_cider_short_name')->value);
    if ($short !== '') {
      return $short;
    }
  }
  return (string) $node->getTitle();
}

/**
 * Implements hook_preprocess_html().
 *
 * Mirror the resource H1: use the resolved display name in the browser
 * <title> for resource pages, not the raw node title. Metatag's own
 * hook_preprocess_html() (metatag_preprocess_html()) overwrites
 * $variables['head_title'] wholesale when a title metatag is configured for
 * the route, so this must run after it. Module registration order in
 * core.extension.yml currently happens to put operations_cider after
 * metatag, but that's incidental and could silently flip on a future
 * module reinstall/reorder. operations_cider_module_implements_alter()
 * below pins this hook to run last explicitly, so the <title> override
 * doesn't depend on extension.yml ordering.
 */
function operations_cider_preprocess_html(array &$variables) {
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof \Drupal\node\NodeInterface
      && $node->bundle() === 'access_active_resources_from_cid'
      && isset($variables['head_title']['title'])) {
    $variables['head_title']['title'] = operations_cider_resource_display_name($node);
  }
}

/**
 * Implements hook_preprocess_node().
 */
function operations_cider_preprocess_node(array &$variables) {
  $node = $variables['node'] ?? NULL;
  if ($node instanceof \Drupal\node\NodeInterface
      && $node->bundle() === 'access_active_resources_from_cid') {
    $variables['resource_display_name'] = operations_cider_resource_display_name($node);
  }
}

/**
 * Implements hook_node_links_alter().
 *
 * NodeViewBuilder::buildLinks() hardcodes $node->label() into the teaser
 * "Read more" link's accessible text and title attribute via a lazy
 * builder, so it can't be reached from hook_preprocess_node() or a
 * template override (the links render array isn't materialized until the
 * lazy builder runs at render time). Rewrite it here — the supported
 * alter hook for this render array — so the link also shows the resolved
 * display name instead of the raw title.
 */
function operations_cider_node_links_alter(array &$links, \Drupal\node\NodeInterface $entity, array &$context) {
  if ($entity->bundle() !== 'access_active_resources_from_cid') {
    return;
  }
  if (!isset($links['node']['#links']['node-readmore'])) {
    return;
  }
  $display_name = operations_cider_resource_display_name($entity);
  $readmore = &$links['node']['#links']['node-readmore'];
  $readmore['title'] = t('Read more<span class="visually-hidden"> about @title</span>', [
    '@title' => $display_name,
  ]);
  $readmore['attributes']['title'] = $display_name;
}

/**
 * Implements hook_preprocess_page_title().
 *
 * The resource page H1 comes from the routed node's label; resolve the
 * display name here so the H1 shows the editor override / short name
 * rather than the raw title.
 */
function operations_cider_preprocess_page_title(array &$variables) {
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof \Drupal\node\NodeInterface
      && $node->bundle() === 'access_active_resources_from_cid') {
    $variables['title'] = operations_cider_resource_display_name($node);
  }
}

/**
 * Implements hook_entity_create().
 */
function operations_cider_entity_presave(EntityInterface $entity) {
  $moduleHandler = \Drupal::service('module_handler');
  if ($entity->getEntityTypeId() == 'node' && $moduleHandler->moduleExists('domain_access')) {
    $type = $entity->bundle();
    if ($type == 'access_active_resources_from_cid') {
      // Only run on new entities.
      if ($entity->id() == NULL) {
        $field_domain_access = $entity->get('field_domain_access')->getValue();
        // Set default domain when null is passed.
        if (empty($field_domain_access)) {
          $entity->set('field_domain_access', 'amp_cyberinfrastructure_org');
        }
      }
    }
  }
}

/**
 * Implements hook_entity_bundle_info_alter().
 *
 * Registers the bundle class that overrides label() so the resource display
 * name resolves at the source for every consumer that calls label().
 */
function operations_cider_entity_bundle_info_alter(array &$bundles): void {
  if (isset($bundles['node']['access_active_resources_from_cid'])) {
    $bundles['node']['access_active_resources_from_cid']['class'] =
      \Drupal\operations_cider\Entity\CiderResourceNode::class;
  }
}

/**
 * Implements hook_module_implements_alter().
 *
 * Ensure operations_cider's preprocess_html runs last so the resource
 * <title> override is not clobbered by another module (e.g. metatag)
 * writing head_title. Removes reliance on core.extension.yml ordering.
 */
function operations_cider_module_implements_alter(&$implementations, $hook) {
  if ($hook === 'preprocess_html' && isset($implementations['operations_cider'])) {
    $group = $implementations['operations_cider'];
    unset($implementations['operations_cider']);
    $implementations['operations_cider'] = $group;
  }
}
